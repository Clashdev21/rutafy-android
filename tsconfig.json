{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "scripts/test-mensajero-operational.ts",
    "scripts/test-control-mobile.ts",
    "scripts/test-operational-bootstrap.ts",
    "scripts/test-operator-ingestion-phase-a.ts",
    "scripts/test-operator-c1-m1.ts"
  ]
}
